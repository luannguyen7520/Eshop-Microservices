# Topmost editorconfig file for .NET Core Backend Development
root = true

# All files - general whitespace and formatting rules
[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# XML/JSON/YAML configuration files (2 spaces for compactness)
[*.{xml,json,yml,yaml}]
indent_size = 2

# C# Code Style and Formatting Rules
[*.cs]

#### 1. CRITICAL: ENFORCE FILE-SCOPED NAMESPACES (C# 10+) ####
csharp_style_namespace_declarations = file_scoped:warning

#### 2. 'var' Usage Preferences ####
csharp_style_var_for_built_in_types = false:suggestion  # Use explicit types for int, string, etc.
csharp_style_var_when_type_is_apparent = true:suggestion # Use var when type is obvious (e.g., new Member())
csharp_style_var_elsewhere = true:suggestion

#### 3. Newline Formatting (Brace Placement) ####
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

#### 4. Modifier Preferences (Standard Industry Order) ####
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion

#### 5. Clean Namespace Imports (System Directives First) ####
dotnet_sort_system_directives_first = true:suggestion
dotnet_separate_import_directive_groups = true:suggestion
